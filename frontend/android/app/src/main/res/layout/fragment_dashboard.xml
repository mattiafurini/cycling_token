<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:id="@+id/text_dashboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/your_ride"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contribute_infrastructure"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/text_dashboard_title"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Speed Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:layout_constraintTop_toBottomOf="@id/text_dashboard_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_speed"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="72sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kmh_unit"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="20sp"
                android:alpha="0.8"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Distance Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_distance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:layout_constraintTop_toBottomOf="@id/card_speed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/card_acceleration">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_distance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 km"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="24sp"
                android:layout_marginTop="8dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Acceleration Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_acceleration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:layout_constraintTop_toBottomOf="@id/card_speed"
        app:layout_constraintStart_toEndOf="@id/card_distance"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/acceleration"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_acceleration_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 m/s²"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="24sp"
                android:layout_marginTop="8dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btn_start_ride"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_ride"
            android:backgroundTint="?attr/colorTertiary"
            android:textColor="?attr/colorOnTertiary"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="?attr/colorOnTertiary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btn_collect_tokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/claim_cycling_tokens"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="?attr/colorOnPrimary"
            android:gravity="center"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>